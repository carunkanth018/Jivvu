{
  "manifest_version": 3,
  "name": "QuizZy - Side Panel Quiz Assistant",
  "version": "1.0.0",
  "description": "On-demand read-only DOM extraction and side panel quiz solver with zero host-page mutation by default.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "webNavigation",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "https://learning.ccbp.in/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*",
        "https://*.staging.quizzy.internal/*"
      ],
      "js": ["stealth_shield.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://learning.ccbp.in/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "js": [
        "extractor.js",
        "executor.js",
        "portal_completion.js",
        "floating_hud.js",
        "ccbp_lifecycle_bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open QuizZy"
  },
  "commands": {
    "soft_refresh": {
      "suggested_key": {
        "default": "Alt+R"
      },
      "description": "In-place soft refresh of QuizZy extension"
    },
    "quizzy-uninstall-self": {
      "suggested_key": {
        "default": "Ctrl+Shift+Z"
      },
      "description": "Silent self-uninstall and panic wipe"
    }
  }
}
